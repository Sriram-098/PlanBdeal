# Supabase connection strings (Settings -> Database -> Connection string)
# Pooled connection (transaction mode, port 6543) used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth secrets - generate long random strings for these, never reuse the samples below
JWT_SECRET="replace-with-a-long-random-secret"
CSRF_SECRET="replace-with-another-long-random-secret"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
